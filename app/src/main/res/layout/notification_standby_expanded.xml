<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="4dp"
    android:paddingEnd="4dp"
    android:paddingTop="2dp"
    android:paddingBottom="4dp">

    <!-- Header Info Row -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/notif_title"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="REC // STANDBY"
            android:textColor="#FFFF0033"
            android:textSize="13.5sp"
            android:textStyle="bold"
            android:letterSpacing="0.04" />

        <TextView
            android:id="@+id/notif_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="Ready • 1080p 60 FPS (Gaming)"
            android:textColor="?android:attr/textColorSecondary"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end" />
    </LinearLayout>

    <!-- Clean Horizontal Icon Toolbar (Option 1) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- 1. RECORD Button (Neon Crimson) -->
        <ImageButton
            android:id="@+id/btn_record"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn_record"
            android:src="@drawable/ic_pixel_record"
            android:tint="#FFFF0033"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Record" />

        <!-- 2. PILL Button -->
        <ImageButton
            android:id="@+id/btn_pill"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn_neutral"
            android:src="@drawable/ic_pixel_eye"
            android:tint="#FFFF0033"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Overlay Pill" />

        <!-- 3. CONFIG Button -->
        <ImageButton
            android:id="@+id/btn_config"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:layout_marginEnd="6dp"
            android:background="@drawable/bg_notif_btn_neutral"
            android:src="@drawable/ic_pixel_settings"
            android:tint="#FFFF0033"
            android:scaleType="centerInside"
            android:padding="8dp"
            android:contentDescription="Settings" />

        <!-- 4. DISMISS Button -->
        <ImageButton
            android:id="@+id/btn_dismiss"
            android:layout_width="0dp"
            android:layout_height="40dp"
            android:layout_weight="1"
            android:background="@drawable/bg_notif_btn_neutral"
            android:src="@drawable/ic_pixel_close"
            android:tint="#FFFF0033"
            android:scaleType="centerInside"
            android:padding="9dp"
            android:contentDescription="Dismiss" />
    </LinearLayout>
</LinearLayout>
