<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 1. Deep Obsidian Background -->
    <item android:drawable="@color/obsidian_background" />

    <!-- 2. Centered Red Pixel REC Core Logo -->
    <item
        android:gravity="center"
        android:width="96dp"
        android:height="96dp"
        android:drawable="@drawable/ic_logo_core" />

    <!-- 3. Bottom REC by PixL Branding (Visible on Frame 0 Cold Boot) -->
    <item
        android:gravity="bottom|center_horizontal"
        android:bottom="48dp"
        android:width="200dp"
        android:height="50dp"
        android:drawable="@drawable/ic_splash_branding" />
</layer-list>
