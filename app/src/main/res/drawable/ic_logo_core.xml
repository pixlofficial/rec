    android:width="48dp"
    android:height="48dp"
    android:viewportWidth="48"
    android:viewportHeight="48">

    <!-- 1. Outer Faint Scarlet Red Glow Halo -->
    <path
        android:fillColor="#22FF0000"
        android:pathData="M24,24m-22,0a22,22 0 1,0 44,0a22,22 0 1,0 -44,0" />

    <!-- 2. Secondary Soft Red Glow -->
